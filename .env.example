# ================================================================
# Future Bound Tech — environment template
# Copy to /etc/future-bound-tech.env (Linux) or keep locally as .env
# (git-ignored). Fill the <...> placeholders with real secrets from
# your secret store. NEVER commit a filled-in copy.
# ================================================================

# ---- Which configuration ----
# h2 | mysql (dev) | prod (production: MySQL + HTTPS + guard-rails)
SPRING_PROFILES_ACTIVE=prod

# ---- Public identity of the site (no invented domain — use YOURS) ----
# Must be https:// under the prod profile (enforced by ProductionValidator).
APP_BASE_URL=https://<your-domain>
SERVER_PORT=8080

# ---- MySQL ----
DB_HOST=<db-host>
DB_PORT=3306
DB_NAME=future_bound_tech_db
DB_USERNAME=fbt_app
DB_PASSWORD=<app-db-password>
DB_POOL_MAX=10
DB_POOL_MIN=2

# ---- Razorpay (LIVE keys in production; never reuse Test keys) ----
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=<rzp_live_key_id>
RAZORPAY_KEY_SECRET=<rzp_live_key_secret>
RAZORPAY_WEBHOOK_SECRET=<webhook-secret-set-in-razorpay-dashboard>

# ---- Bootstrap admin (first deployment only; then set BOOTSTRAP_SEEDS=false) ----
BOOTSTRAP_SEEDS=true
ADMIN_SEED_EMAIL=<your-admin-email>
ADMIN_SEED_PASSWORD=<strong-one-time-password>

# ---- Uploads (persistent storage, outside the web root) ----
UPLOAD_DIR=/var/opt/future-bound-tech/uploads
PRIVATE_UPLOAD_DIR=/var/opt/future-bound-tech/private-uploads
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=10MB

# ---- Logging ----
LOG_FILE=/var/log/future-bound-tech/app.log
LOG_LEVEL_APP=INFO
LOG_MAX_FILE_SIZE=20MB
LOG_MAX_HISTORY=30
STATIC_CACHE_PERIOD=3600

# ---- HTTPS / sessions ----
APP_HSTS_ENABLED=true
SESSION_COOKIE_SECURE=true

# ---- Notifications ----
NOTIFICATION_REMINDERS_ENABLED=true
NOTIFICATION_REMINDERS_CRON=0 0 * * * *
NOTIFICATION_CLASS_LEAD_MINUTES=120
NOTIFICATION_ASSIGNMENT_LEAD_HOURS=24

# ---- Optional e-mail (leave disabled until the institute address exists) ----
APP_EMAIL_ENABLED=false
APP_EMAIL_FROM=
APP_EMAIL_SUBJECT_PREFIX=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ---- Backup cron (deploy/backup.sh) ----
BACKUP_DB_USERNAME=fbt_backup
BACKUP_DB_PASSWORD=<backup-db-password>
BACKUP_DIR=/var/backups/future-bound-tech
RETENTION_DAYS=30
